# Neon: copie a "connection string" do painel do Neon (com ?sslmode=require).
# Local: docker compose up -d  →  postgres://postgres:postgres@localhost:5434/personal_finance
DATABASE_URL=

# Fuso horário usado para "hoje" (padrão America/Sao_Paulo).
NEXT_PUBLIC_TIME_ZONE=America/Sao_Paulo

# Leitura de comprovantes por IA (aba "Ler comprovante"). Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão gemini-3.8-flash).
GEMINI_MODEL=
